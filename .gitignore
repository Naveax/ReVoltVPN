*.pyc

# ── Flutter / Dart ─────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
**/build/
local_packages/*/build/
local_packages/*/.dart_tool/
*.dart_tool/
**/doc/api/
**/ios/Flutter/.last_build_id

# ── Android ────────────────────────────────────────────────────────────────
